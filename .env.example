# Copiá este archivo a .env.local y completá los valores. No lo subas con datos reales.
# Sin SUPABASE_SERVICE_ROLE_KEY, en desarrollo la app abre en modo demostración (datos de ejemplo, sin ingreso).

# --- Base de datos y acceso (Supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Servidor ---
# Dirección pública del sistema, sin barra final (se usa en enlaces y en las autorizaciones).
APP_BASE_URL=
# Secreto de las tareas programadas y rutas internas (mínimo 16 caracteres).
CRON_SECRET=
# Clave que cifra los tokens guardados y firma los enlaces (mínimo 32 caracteres). Una distinta por despliegue.
TOKEN_ENC_KEY=

# --- Solo desarrollo ---
# 1 = entrar sin iniciar sesión con una base Supabase configurada (nunca vale en producción).
DEV_BYPASS_AUTH=0
# file = usar los datos de ejemplo en archivo aunque haya claves de Supabase.
DATA_SOURCE=

# --- Integraciones (las completa quien instala el sistema) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
TN_CLIENT_ID=
TN_CLIENT_SECRET=
META_APP_SECRET=
META_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
